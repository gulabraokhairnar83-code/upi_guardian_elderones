# UPI Guardian - Environment Configuration Template

# Frontend Settings
# Base URL for Flask REST API backend
VITE_API_BASE_URL=http://127.0.0.1:5000/api
# Set to 'false' to connect to live Flask backend with secure JWT authentication
# Set to 'true' to use standalone client-side mock data provider
VITE_USE_MOCK_API=false

# Backend Settings (Flask + MongoDB)
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8080

# Database Configuration
# In development, leave MONGODB_URI empty and set USE_MOCK_DB=true for built-in in-memory mongomock
MONGODB_URI=
MONGODB_DATABASE=upi_guardian_dev
USE_MOCK_DB=true
