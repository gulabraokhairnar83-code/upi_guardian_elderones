# UPI Guardian - Flask Backend Environment Configuration

# Environment mode: development, testing, production
FLASK_ENV=development
FLASK_DEBUG=1

# Server port and host
PORT=5000
HOST=0.0.0.0

# Secret key for sessions / cookies (Set a secure random key in production)
SECRET_KEY=dev-secret-key-change-in-production

# CORS Allowed Origins (comma-separated or wildcard for local dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# MongoDB Atlas Configuration
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=upi_guardian_dev

# Use in-memory mock MongoDB when MONGODB_URI is empty or during offline development (true/false)
USE_MOCK_DB=true

# Authentication (Phase 8)
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES=3600

# Twilio Notification System (Phase 8)
# Keep TWILIO_ENABLED=false for safe development/testing (simulated mock provider)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
