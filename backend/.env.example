# UPI Guardian - Flask Backend Environment Configuration

# Environment mode: development, testing, production
FLASK_ENV=development
FLASK_DEBUG=1

# Server port and host
PORT=5000
HOST=0.0.0.0

# Secret key for sessions / cookies (Set a secure random key in production)
SECRET_KEY=dev-secret-key-change-in-production

# CORS Allowed Origins (comma-separated or wildcard for local dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8080

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# MongoDB Atlas Configuration
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=upi_guardian_dev

# Use in-memory mock MongoDB (mongomock) when MONGODB_URI is empty or during offline development (true/false)
USE_MOCK_DB=true

# Authentication (JWT & Passwords)
# Provide a strong, cryptographically secure key in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800

# Twilio Notification System (Phase 8)
# Keep TWILIO_ENABLED=false for safe development/testing (simulated mock provider)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
