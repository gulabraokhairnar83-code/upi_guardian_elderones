# UPI Guardian - Production Environment Configuration Template
# DO NOT COMMIT REAL PRODUCTION SECRETS TO SOURCE CONTROL

# Flask Environment Mode
FLASK_ENV=production
FLASK_DEBUG=0

# Server Binding
PORT=5000
HOST=0.0.0.0

# Session Secret (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# JWT Configuration (Must be strong and distinct from SECRET_KEY)
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# CORS Allowed Origins (Comma-separated exact domains, NO wildcards in production)
CORS_ORIGINS=https://upi-guardian.yourdomain.com,https://dashboard.yourdomain.com

# Logging Level: INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Security Headers: Enforce Strict-Transport-Security (HTTPS only)
ENABLE_HSTS=true

# Rate Limiting: Enable in-memory/infrastructure rate limiting
RATE_LIMIT_ENABLED=true

# MongoDB Atlas Production Configuration
# Atlas Network Access should be restricted to trusted IP allowlists/VPC peering
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority&appName=UPIGuardianProd
MONGODB_DATABASE=upi_guardian_prod
USE_MOCK_DB=false

# Twilio Notification Configuration (Phase 8/9 - Disabled by default)
# Set to 'true' only after verifying valid production credentials and approved templates
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=CHANGE_ME_AC_XXXXX
TWILIO_AUTH_TOKEN=CHANGE_ME_AUTH_TOKEN
TWILIO_FROM_PHONE=+1XXXXXXXXXX
