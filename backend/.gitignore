# UPI Guardian - Backend .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
.env.local
!.env.example
!.env.production.example

# Pytest / Coverage
.pytest_cache/
.coverage
htmlcov/

# Generated Training Datasets (preserves production models in app/ml/models and app/nlp/models)
app/ml/data/*.csv

# IDE & OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log
