# UPI Guardian - Environment Configuration Template
# Base URL for Flask REST API backend
VITE_API_BASE_URL=http://127.0.0.1:5000/api

# Enable mock API provider during frontend development (true / false)
# When 'false', connects to real Flask backend + MongoDB.
# When 'true', operates in standalone demo mode with mock data.
VITE_USE_MOCK_API=false
