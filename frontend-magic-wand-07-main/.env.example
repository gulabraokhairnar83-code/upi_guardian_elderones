# UPI Guardian - Frontend Environment Configuration

# Base URL for Flask REST API backend (must end with /api or match backend host)
VITE_API_BASE_URL=http://127.0.0.1:5000/api

# API Mode Toggle:
# Set to 'false' to connect to the live Flask REST API with secure JWT authentication.
# Set to 'true' to use the offline mock data provider for prototype demonstration without backend.
VITE_USE_MOCK_API=false
