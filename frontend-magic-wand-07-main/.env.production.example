# UPI Guardian Frontend - Production Environment Configuration Template
# DO NOT PUT BACKEND SECRETS, DATABASE PASSWORDS, OR TWILIO TOKENS HERE!

# URL of the deployed Flask REST API (HTTPS required in production)
VITE_API_BASE_URL=https://api-upi-guardian.yourdomain.com/api

# Always disable mock API in production so live traffic connects to the secured Flask API
VITE_USE_MOCK_API=false
